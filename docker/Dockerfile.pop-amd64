# Pop!_OS 22.04 (Ubuntu 22.04 base + System76 Pop apt repo). No official
# Pop!_OS container image is published, so the Pop repo is layered onto its
# exact Ubuntu base; apt update must succeed against apt.pop-os.org.
FROM ubuntu:22.04
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends curl gnupg ca-certificates \
 && mkdir -p /etc/apt/keyrings \
 && curl -fsSL "https://keyserver.ubuntu.com/pks/lookup?op=get&search=0x204DD8AEC33A7AFF" | gpg --dearmor -o /etc/apt/keyrings/pop.gpg \
 && echo "deb [signed-by=/etc/apt/keyrings/pop.gpg] http://apt.pop-os.org/release jammy main" > /etc/apt/sources.list.d/pop.list \
 && apt-get update \
 && apt-get install -y --no-install-recommends \
    build-essential git make pkg-config gdb xvfb xauth wget unzip ccache sudo file \
 && rm -rf /var/lib/apt/lists/*
RUN apt-get update && apt-get install -y --no-install-recommends \
    freeglut3-dev libasound2-dev libxmu-dev libxxf86vm-dev \
    libgl1-mesa-dev libglu1-mesa-dev libraw1394-dev libudev-dev libdrm-dev \
    libglew-dev libopenal-dev libsndfile1-dev libfreeimage-dev libcairo2-dev \
    libfreetype6-dev libssl-dev libpulse-dev libusb-1.0-0-dev \
    libegl1-mesa-dev libglvnd-dev libgles2-mesa-dev libassimp-dev librtaudio-dev \
    libgstreamer1.0-dev libgstreamer-plugins-base1.0-dev \
    liburiparser-dev libcurl4-openssl-dev libxml2-dev libpugixml-dev libpoco-dev \
    libglfw3-dev libxrandr-dev libxinerama-dev libxcursor-dev libxi-dev \
    liblapack-dev libblas-dev libopencv-dev \
 && rm -rf /var/lib/apt/lists/*
WORKDIR /src
