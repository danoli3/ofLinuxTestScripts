# Linux Mint 22.2 (Ubuntu 24.04 base) - official Mint dev image, x86_64 only.
FROM linuxmintd/mint22.2-amd64:latest
ENV DEBIAN_FRONTEND=noninteractive
USER root
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential git make pkg-config gdb xvfb xauth curl wget unzip ca-certificates ccache sudo file \
 && rm -rf /var/lib/apt/lists/*
WORKDIR /src
