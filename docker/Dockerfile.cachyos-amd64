# CachyOS (Arch base, x86-64-v3 optimised) - official image.
FROM cachyos/cachyos-v3:latest
RUN pacman -Syu --noconfirm git make gcc pkgconf gdb xorg-server-xvfb \
    curl wget unzip ca-certificates ccache sudo file \
 && pacman -Scc --noconfirm
RUN pacman -S --noconfirm --needed openal glew freeglut gstreamer \
    gst-plugins-base gst-plugins-good gst-plugins-bad gst-libav opencv base-devel \
    assimp glfw-x11 uriparser curl pugixml rtaudio poco cairo freetype2 \
    libsndfile libusb libxml2 openssl alsa-lib libpulse \
 && pacman -Scc --noconfirm
RUN useradd -m builder \
 && echo "builder ALL=(ALL) NOPASSWD: ALL" >> /etc/sudoers \
 && su builder -c 'git clone https://aur.archlinux.org/freeimage.git /tmp/freeimage && cd /tmp/freeimage && makepkg -si --noconfirm' \
 && rm -rf /tmp/freeimage
WORKDIR /src
