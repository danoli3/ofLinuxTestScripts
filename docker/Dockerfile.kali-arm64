# Kali Linux (rolling, Debian testing base) - official image.
FROM kalilinux/kali-rolling:latest
ENV DEBIAN_FRONTEND=noninteractive
USER root
RUN sed -i 's|http://http.kali.org/kali|http://mirrors.ocf.berkeley.edu/kali|g' /etc/apt/sources.list /etc/apt/sources.list.d/* 2>/dev/null || true
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential git make pkg-config gdb xvfb xauth curl wget unzip ca-certificates ccache sudo file \
    freeglut3-dev libasound2-dev libxmu-dev libxxf86vm-dev \
    libgl1-mesa-dev libglu1-mesa-dev libraw1394-dev libudev-dev libdrm-dev \
    libglew-dev libopenal-dev libsndfile1-dev libcairo2-dev \
    libfreetype6-dev libssl-dev libpulse-dev libusb-1.0-0-dev \
    libegl1-mesa-dev libglvnd-dev libgles2-mesa-dev libassimp-dev librtaudio-dev \
    libgstreamer1.0-dev libgstreamer-plugins-base1.0-dev \
    liburiparser-dev libcurl4-openssl-dev libxml2-dev libpugixml-dev libpoco-dev \
    libglfw3-dev libxrandr-dev libxinerama-dev libxcursor-dev libxi-dev \
    liblapack-dev libblas-dev libopencv-dev \
 && rm -rf /var/lib/apt/lists/*
WORKDIR /src
